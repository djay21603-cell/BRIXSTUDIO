# Server-side secrets. Copy to .env and fill in locally. Never commit a filled-in .env file.

# The studio recipient is fixed in server/email.js (mendozafabillar@gmail.com).
# The browser never receives these credentials.

# Option 0 (recommended on hosts that block outbound SMTP, such as Render free):
# Brevo HTTPS API. Uses port 443, so SMTP port blocking does not apply.
# 1. Create a Brevo account and verify the sender address you want to send from.
# 2. Set BREVO_API_KEY to a v3 API key. BREVO_SENDER is only needed when
#    MAIL_FROM does not already name the verified sender.
# BREVO_API_KEY=
# BREVO_SENDER=studio@example.com
# MAIL_FROM="BRIX Studio <studio@example.com>"

# Option 1: any SMTP provider. Ignored when BREVO_API_KEY is set.
# SMTP_HOST=mail.example.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=studio@example.com
# SMTP_PASS=
# MAIL_FROM="BRIX Studio <studio@example.com>"

# The Gmail account that sends the mail. Required for both options below.
GMAIL_USER=

# Option A (recommended): Gmail API with OAuth 2.0.# 1. In Google Cloud Console create an OAuth client (type: Desktop or Web).
# 2. Enable the Gmail API for that project.
# 3. Authorize scope https://www.googleapis.com/auth/gmail.send for GMAIL_USER,
#    then store the refresh token. Server exchanges it for short-lived access tokens.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# Option B: Gmail SMTP with a Google App Password (used when Option A is incomplete).
# 1. Turn on 2-Step Verification for the Google account.
# 2. Google Account > Security > App passwords > create one for "Mail".
GMAIL_APP_PASSWORD=

# AI assistant (optional). Any OpenAI-compatible chat completions endpoint.
# Without these values the assistant runs on the built-in deterministic planner.
ASSISTANT_API_KEY=
ASSISTANT_BASE_URL=https://api.openai.com/v1
ASSISTANT_MODEL=gpt-4o-mini

# Server port. Vite proxies /api to this port during development.
PORT=8787

# --- Phase 0 foundation -----------------------------------------------------
# Where the SQLite database and uploaded files live. Keep this on a persistent
# disk in production; Render's default disk is ephemeral.
DATA_DIR=var/data

# Public origin of the site, used to validate same-origin requests behind a proxy.
# Example: https://brix-studio.onrender.com
PUBLIC_ORIGIN=

# Upload limits (bytes). Per-file cap and per-user total storage quota.
UPLOAD_MAX_FILE_BYTES=10485760
UPLOAD_USER_QUOTA_BYTES=104857600
UPLOAD_USER_MAX_FILES=200

# Builder attachments (logo + reference images) are stored per draft and linked to
# the inquiry when the brief is submitted. Abandoned drafts are cleaned up hourly.
INQUIRY_UPLOAD_MAX_FILES=8
INQUIRY_UPLOAD_TOTAL_BYTES=20971520
INQUIRY_UPLOAD_RETENTION_DAYS=14

# Days to keep security audit events before cleanup (sessions expire after 30 days).
AUDIT_RETENTION_DAYS=180
